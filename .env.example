# These VITE_ values are public website content, never secrets.
VITE_BASE_PATH=/PourTallyWebsite/
VITE_SITE_URL=https://billcorps.github.io/PourTallyWebsite/

# Public name defaults to site-defaults.json; override only when needed.
VITE_DEVELOPER_NAME=William Haggerty

# Public support and privacy contact; defaults to this address in site-defaults.json.
VITE_SUPPORT_EMAIL=bartallysupport@gmail.com

# Optional override; blank uses the public Google Play listing in site-defaults.json.
VITE_PLAY_STORE_URL=

# Optional: defaults to VITE_SITE_URL + images/social-card.png.
VITE_SOCIAL_IMAGE=
